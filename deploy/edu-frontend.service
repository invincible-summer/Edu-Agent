[Unit]
Description=Edu_Agent frontend (Next.js next start)
Wants=network-online.target
After=network-online.target edu-agent-backend.service

[Service]
Type=simple
User=ecs-user
Group=ecs-user
UMask=0077
WorkingDirectory=/opt/edu-agent
Environment=NODE_ENV=production
Environment=BACKEND_URL=http://127.0.0.1:8123
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env pnpm --dir /opt/edu-agent/frontend exec next start -H 127.0.0.1 -p 3030
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
