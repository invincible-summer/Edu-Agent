            ],
            "definition": "等差数列可用首项、公差和序号表示各项及其前n项和。",
            "example": "a_n=a_1+(n-1)d。"
          },
          {
            "name": "等比数列",
            "difficulty": 2,
            "description": "相邻两项的比为同一常数的数列",
