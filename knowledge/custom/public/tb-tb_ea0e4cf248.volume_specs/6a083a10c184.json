      {
        "name": "第五章 一元函数的导数及其应用",
        "concepts": [
          {
            "name": "平均变化率",
            "difficulty": 2,
            "description": "函数值变化量与自变量变化量的比值",
            "aliases": [],
            "prerequisites": [],
            "definition": "函数从一个自变量值变化到另一个值时，函数值变化量与自变量变化量的比值称为平均变化率。",
            "example": "f(x)=x²从1到1+Δx的平均变化率为2+Δx。"
          },
          {
            "name": "瞬时速度",
            "difficulty": 2,
            "description": "物体在某一时刻的速度",
            "aliases": [],
            "prerequisites": [
              "平均变化率"
            ],
            "definition": "物体在某一时刻的速度称为瞬时速度。",
            "example": "跳水运动员t=1秒时的瞬时速度为−5米/秒。"
          },
          {
            "name": "极限",
            "difficulty": 3,
            "description": "变量无限趋近时函数值趋近的确定值",
            "aliases": [],
            "prerequisites": [],
            "definition": "当变量无限趋近某值时，函数值无限趋近的确定值称为该函数的极限。",
            "example": "lim(Δx→0)(2+Δx)=2。"
          },
          {
            "name": "割线斜率",
            "difficulty": 2,
            "description": "曲线上两点连成割线的斜率",
            "aliases": [
              "割线的斜率"
            ],
            "prerequisites": [
              "平均变化率"
            ],
            "definition": "曲线上两点连成的割线的斜率等于两点纵坐标差与横坐标差之比。",
            "example": "y=x²在(1,1)与(1+Δx,(1+Δx)²)间割线斜率为2+Δx。"
          },
          {
            "name": "切线",
            "difficulty": 3,
            "description": "割线趋近确定位置时得到的直线",
            "aliases": [
              "切线"
            ],
            "prerequisites": [
              "割线斜率",
              "极限"
            ],
            "definition": "曲线上一点附近的另一点无限趋近该点时，割线无限趋近的确定位置直线称为切线。",
            "example": "y=x²在(1,1)处的切线斜率为2。"
          },
          {
            "name": "导数",
            "difficulty": 3,
            "description": "函数在一点处的瞬时变化率",
            "aliases": [
              "瞬时变化率"
            ],
            "prerequisites": [
              "平均变化率",
              "极限"
            ],
            "definition": "平均变化率在自变量改变量趋于零时的极限称为函数在该点的导数。",
            "example": "f(x)=x²时，f'(1)=lim(Δx→0)[f(1+Δx)−f(1)]/Δx=2。"
          },
          {
            "name": "导数的几何意义",
            "difficulty": 3,
            "description": "导数等于函数图象切线的斜率",
            "aliases": [],
            "prerequisites": [
              "导数",
              "切线"
            ],
            "definition": "函数在一点处的导数等于其图象在该点处切线的斜率。",
            "example": "y=x²在(1,1)处导数为2，故切线斜率为2。"
          },
          {
            "name": "导函数",
            "difficulty": 3,
            "description": "函数各点导数组成的新函数",
            "aliases": [
              "导数函数"
            ],
            "prerequisites": [
              "导数"
            ],
            "definition": "当函数在区间内每一点都可导时，各点导数组成的函数称为导函数。",
            "example": "f(x)=x²的导函数为f'(x)=2x。"
          },
          {
            "name": "基本导数公式",
            "difficulty": 2,
            "description": "基本初等函数的导数计算公式",
            "aliases": [
              "基本初等函数的导数公式"
            ],
            "prerequisites": [
              "导数"
            ],
            "definition": "教材给出的幂函数、指数函数、对数函数及三角函数等的导数公式称为基本导数公式。",
            "example": "(x³)'=3x²，(sin x)'=cos x。"
          },
          {
            "name": "导数四则法则",
            "difficulty": 3,
            "description": "和、差、积、商函数的求导规则",
            "aliases": [
              "导数的四则运算法则"
            ],
            "prerequisites": [
              "导数",
              "基本导数公式"
            ],
            "definition": "利用函数和、差、积、商的结构计算导数的规则称为导数四则法则。",
            "example": "(eˣln x)'=eˣln x+eˣ/x。"
          },
          {
            "name": "复合函数",
            "difficulty": 3,
            "description": "通过中间变量复合得到的函数",
            "aliases": [
              "复合函数"
            ],
            "prerequisites": [
              "函数"
            ],
            "definition": "通过中间变量把两个函数连接起来，使y表示为x的函数，称为复合函数。",
            "example": "ln(2x−1)由y=ln u与u=2x−1复合而成。"
          },
          {
            "name": "复合函数求导",
            "difficulty": 3,
            "description": "复合函数导数等于内外层导数之积",
            "aliases": [
              "复合函数的求导法则",
              "链式法则"
            ],
            "prerequisites": [
              "导数",
              "复合函数",
              "基本导数公式"
            ],
            "definition": "复合函数对自变量的导数等于外层函数对中间变量的导数与内层函数导数的乘积。",
            "example": "(3x+5)³'=9(3x+5)²。",
            "section": "5.2 导数的运算"
          },
          {
            "name": "导数与单调性",
            "difficulty": 3,
            "description": "用导数正负判断函数增减",
            "aliases": [
              "函数单调性判定"
            ],
            "prerequisites": [
              "导函数"
            ],
            "definition": "在区间内，导数大于零通常对应函数单调递增，导数小于零通常对应函数单调递减。",
            "example": "f'(x)>0的区间上，f(x)单调递增。"
          },
          {
            "name": "函数极值",
            "difficulty": 3,
            "description": "函数在某点附近的局部最大或最小值",
            "aliases": [
              "极值"
            ],
            "prerequisites": [
              "导数与单调性"
            ],
            "definition": "函数在某点附近的函数值都不大于或不小于该点函数值时，该点函数值称为极值。",
            "example": "f'(x)由正变负时，函数在该点取得极大值。",
            "section": "5.3 导数在研究函数中的应用"
          },
          {
            "name": "闭区间最值",
            "difficulty": 3,
            "description": "函数在闭区间上的最大值和最小值",
            "aliases": [
              "最大值与最小值"
            ],
            "prerequisites": [
              "函数极值",
              "导数与单调性"
            ],
            "definition": "函数在给定闭区间内取得的最大函数值和最小函数值称为闭区间上的最值。",
            "example": "比较端点值与区间内极值可求闭区间最值。",
            "section": "5.3 导数在研究函数中的应用"
          },
          {
            "name": "优化问题",
            "difficulty": 3,
            "description": "利用导数求实际问题中的最优结果",
            "aliases": [
              "最值应用"
            ],
            "prerequisites": [
              "闭区间最值"
            ],
            "definition": "把实际问题转化为函数最值问题并求出最优结果的方法称为优化问题。",
            "example": "截铁丝弯成正方形，使面积和最小。",
            "section": "5.3 导数在研究函数中的应用"
          },
          {
            "name": "牛顿法",
            "difficulty": 4,
            "description": "利用切线迭代求方程近似解的方法",
            "aliases": [
              "牛顿迭代法"
            ],
            "prerequisites": [
              "导数",
              "切线"
            ],
            "definition": "通过函数图象上切线与横轴交点的迭代来求方程近似根的方法称为牛顿法。",
            "example": "xₙ=xₙ₋₁−f(xₙ₋₁)/f'(xₙ₋₁)。",
            "section": "5.2 导数的运算"
          }
        ],
