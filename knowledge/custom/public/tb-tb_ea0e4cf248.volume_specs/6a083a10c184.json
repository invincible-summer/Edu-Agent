      {
        "name": "第四章 数列",
        "concepts": [
          {
            "name": "数列",
            "difficulty": 1,
            "description": "按确定顺序排列的一列数",
            "aliases": [
              "数列函数"
            ],
            "prerequisites": [],
            "definition": "数列是按照确定顺序排列的一列数。",
            "example": "1，3，5，7，…"
          },
          {
            "name": "数列的项",
            "difficulty": 1,
            "description": "数列中按位置排列的各个数",
            "aliases": [
              "项",
              "首项"
            ],
            "prerequisites": [
              "数列"
            ],
            "definition": "数列中的每一个数叫做这个数列的项。",
            "example": "数列1，3，5中，3是第2项。"
          },
          {
            "name": "有穷数列",
            "difficulty": 1,
            "description": "项数有限的数列",
            "aliases": [],
            "prerequisites": [
              "数列"
            ],
            "definition": "项数有限的数列叫做有穷数列。",
            "example": "1，2，3，4。",
            "section": "4.1 数列的概念"
          },
          {
            "name": "无穷数列",
            "difficulty": 1,
            "description": "项数无限的数列",
            "aliases": [],
            "prerequisites": [
              "数列"
            ],
            "definition": "项数无限的数列叫做无穷数列。",
            "example": "1，2，3，…。",
            "section": "4.1 数列的概念"
          },
          {
            "name": "数列函数",
            "difficulty": 2,
            "description": "定义在正整数集上的离散函数",
            "aliases": [
              "离散函数"
            ],
            "prerequisites": [
              "数列"
            ],
            "definition": "数列是定义在正整数集或其有限子集上的函数。",
            "example": "a_n=n^2把n对应到a_n。"
          },
          {
            "name": "数列图象",
            "difficulty": 2,
            "description": "用坐标点表示数列各项",
            "aliases": [],
            "prerequisites": [
              "数列函数"
            ],
            "definition": "在平面直角坐标系中以点(n,a_n)表示数列的图象。",
            "example": "a_n=n的图象含点(1,1)、(2,2)。"
          },
          {
            "name": "单调数列",
            "difficulty": 2,
            "description": "各项按序递增、递减或相等的数列",
            "aliases": [
              "递增数列",
              "递减数列",
              "常数列"
            ],
            "prerequisites": [
              "数列"
            ],
            "definition": "数列各项随序号增大而具有递增、递减或相等的变化规律。",
            "example": "1，2，3，…是递增数列。"
          },
          {
            "name": "通项公式",
            "difficulty": 2,
            "description": "表示第n项与序号关系的式子",
            "aliases": [
              "数列解析式"
            ],
            "prerequisites": [
              "数列函数"
            ],
            "definition": "表示数列第n项a_n与序号n之间对应关系的式子叫通项公式。",
            "example": "a_n=(-1/2)^n。"
          },
          {
            "name": "递推公式",
            "difficulty": 3,
            "description": "表示数列相邻项关系的式子",
            "aliases": [],
            "prerequisites": [
              "数列的项"
            ],
            "definition": "表示数列相邻两项或多项之间关系的式子叫递推公式。",
            "example": "a_1=1，a_n=3a_{n-1}。"
          },
          {
            "name": "前n项和",
            "difficulty": 2,
            "description": "数列从首项到第n项的各项之和",
            "aliases": [
              "S_n"
            ],
            "prerequisites": [
              "数列的项"
            ],
            "definition": "数列从第1项到第n项止的各项之和叫前n项和。",
            "example": "S_3=a_1+a_2+a_3。"
          },
          {
            "name": "前n项和公式",
            "difficulty": 3,
            "description": "表示前n项和与n关系的式子",
            "aliases": [],
            "prerequisites": [
              "前n项和"
            ],
            "definition": "表示前n项和S_n与序号n之间对应关系的式子叫前n项和公式。",
            "example": "等差数列中S_n=n(a_1+a_n)/2。"
          },
          {
            "name": "等差数列",
            "difficulty": 2,
            "description": "相邻两项的差为同一常数的数列",
            "aliases": [
              "算术级数"
            ],
            "prerequisites": [
              "数列"
            ],
            "definition": "从第2项起每项与前一项的差都等于同一个常数的数列叫等差数列。",
            "example": "2，5，8，11，…。"
          },
          {
            "name": "公差",
            "difficulty": 2,
            "description": "等差数列相邻项的共同差",
            "aliases": [
              "d"
            ],
            "prerequisites": [
              "等差数列"
            ],
            "definition": "等差数列中每项与前一项的差叫公差，通常用d表示。",
            "example": "2，5，8的公差是3。"
          },
          {
            "name": "等差中项",
            "difficulty": 3,
            "description": "使三数构成等差数列的中间数",
            "aliases": [
              "算术中项"
            ],
            "prerequisites": [
              "等差数列"
            ],
            "definition": "在a与b中间插入G使a，G，b成等差数列时，G叫等差中项。",
            "example": "2，5，8成等差数列，5是中项。"
          },
          {
            "name": "等差数列公式",
            "difficulty": 3,
            "description": "等差数列的通项及前n项和公式",
            "aliases": [
              "等差通项公式",
              "等差求和公式"
            ],
            "prerequisites": [
              "等差数列",
              "公差",
              "前n项和"
            ],
            "definition": "等差数列可用首项、公差和序号表示各项及其前n项和。",
            "example": "a_n=a_1+(n-1)d。"
          },
          {
            "name": "等比数列",
            "difficulty": 2,
            "description": "相邻两项的比为同一常数的数列",
            "aliases": [
              "几何级数"
            ],
            "prerequisites": [
              "数列"
            ],
            "definition": "从第2项起每项与前一项的比都等于同一个常数的数列叫等比数列。",
            "example": "2，6，18，54，…。"
          },
          {
            "name": "公比",
            "difficulty": 2,
            "description": "等比数列相邻项的共同比",
            "aliases": [
              "q"
            ],
            "prerequisites": [
              "等比数列"
            ],
            "definition": "等比数列中每项与前一项的比叫公比，通常用q表示且q不为0。",
            "example": "2，6，18的公比是3。"
          },
          {
            "name": "等比中项",
            "difficulty": 3,
            "description": "使三数构成等比数列的中间数",
            "aliases": [
              "几何中项"
            ],
            "prerequisites": [
              "等比数列"
            ],
            "definition": "在a与b中间插入G使a，G，b成等比数列时，G叫等比中项。",
            "example": "2，4，8成等比数列，4是中项。"
          },
          {
            "name": "等比数列公式",
            "difficulty": 3,
            "description": "等比数列的通项及前n项和公式",
            "aliases": [
              "等比通项公式",
              "等比求和公式"
            ],
            "prerequisites": [
              "等比数列",
              "公比",
              "前n项和"
            ],
            "definition": "等比数列可用首项、公比和序号表示各项及其前n项和。",
            "example": "a_n=a_1q^{n-1}。"
          },
          {
            "name": "数学归纳法",
            "difficulty": 3,
            "description": "证明正整数命题的一种特殊方法",
            "aliases": [],
            "prerequisites": [
              "数列"
            ],
            "definition": "数学归纳法通过归纳奠基和归纳递推证明命题对所有正整数成立。",
            "example": "先证n=1，再由n=k推出n=k+1。",
            "section": "4.4* 数学归纳法"
          },
          {
            "name": "归纳奠基",
            "difficulty": 3,
            "description": "验证数学归纳法的初始情形",
            "aliases": [
              "第一步"
            ],
            "prerequisites": [
              "数学归纳法"
            ],
            "definition": "归纳奠基是验证命题在起始正整数处成立。",
            "example": "验证等式在n=1时成立。",
            "section": "4.4* 数学归纳法"
          },
          {
            "name": "归纳递推",
            "difficulty": 3,
            "description": "由第k项成立推出第k+1项成立",
            "aliases": [
              "第二步"
            ],
            "prerequisites": [
              "数学归纳法"
            ],
            "definition": "归纳递推是假设命题在n=k时成立并证明其在n=k+1时成立。",
            "example": "由S_k公式推出S_{k+1}公式。",
            "section": "4.4* 数学归纳法"
          }
        ],
