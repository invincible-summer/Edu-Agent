            ],
            "definition": "数列各项随序号增大而具有递增、递减或相等的变化规律。",
            "example": "1，2，3，…是递增数列。"
          },
          {
            "name": "通项公式",
            "difficulty": 2,
            "description": "表示第n项与序号关系的式子",
            "aliases": [
              "数列解析式"
            ],
            "prerequisites": [
              "数列函数"
            ],
            "definition": "表示数列第n项a_n与序号n之间对应关系的式子叫通项公式。",
            "example": "a_n=(-1/2)^n。"
          },
          {
            "name": "递推公式",
            "difficulty": 3,
            "description": "表示数列相邻项关系的式子",
            "aliases": [],
            "prerequisites": [
              "数列的项"
            ],
            "definition": "表示数列相邻两项或多项之间关系的式子叫递推公式。",
            "example": "a_1=1，a_n=3a_{n-1}。"
          },
          {
            "name": "前n项和",
            "difficulty": 2,
            "description": "数列从首项到第n项的各项之和",
            "aliases": [
              "S_n"
            ],
            "prerequisites": [
              "数列的项"
            ],
            "definition": "数列从第1项到第n项止的各项之和叫前n项和。",
            "example": "S_3=a_1+a_2+a_3。"
          },
          {
            "name": "前n项和公式",
            "difficulty": 3,
            "description": "表示前n项和与n关系的式子",
            "aliases": [],
            "prerequisites": [
              "前n项和"
            ],
            "definition": "表示前n项和S_n与序号n之间对应关系的式子叫前n项和公式。",
            "example": "等差数列中S_n=n(a_1+a_n)/2。"
          },
          {
            "name": "等差数列",
            "difficulty": 2,
            "description": "相邻两项的差为同一常数的数列",
            "aliases": [
