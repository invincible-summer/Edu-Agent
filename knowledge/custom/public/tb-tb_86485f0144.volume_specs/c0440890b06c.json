        "name": "第四章　相似矩阵及二次型",
        "concepts": [
          {
            "name": "向量内积",
            "difficulty": 2,
            "description": "n维向量x与y的内积为xᵀy。",
            "aliases": [
              "内积",
              "数量积"
            ],
            "prerequisites": [],
            "definition": "向量内积是对应分量乘积之和，即[x,y]=xᵀy。",
            "example": "[(1,2),(3,4)]=11"
          },
          {
            "name": "向量长度",
            "difficulty": 2,
            "description": "由内积定义的向量范数。",
            "aliases": [
              "范数"
            ],
            "prerequisites": [
              "向量内积"
            ],
            "definition": "向量长度定义为||x||=√[x,x]。",
            "example": "||(3,4)||=5",
            "section": "第一节 向量的内积、长度及正交性"
          },
          {
            "name": "单位向量",
            "difficulty": 1,
            "description": "长度等于1的向量。",
            "aliases": [],
            "prerequisites": [
              "向量长度"
            ],
            "definition": "长度为1的向量称为单位向量。",
            "example": "(1,0,0)是单位向量",
            "section": "第一节 向量的内积、长度及正交性"
          },
          {
            "name": "向量单位化",
            "difficulty": 2,
            "description": "将非零向量化为单位向量的过程。",
            "aliases": [
              "单位化"
            ],
            "prerequisites": [
              "向量长度",
              "单位向量"
            ],
            "definition": "非零向量α除以其长度得到单位向量的过程。",
            "example": "α=(3,4)化为(3/5,4/5)"
          },
          {
            "name": "向量夹角",
            "difficulty": 2,
            "description": "由内积和长度定义的两个向量间角度。",
            "aliases": [
              "夹角"
            ],
            "prerequisites": [
              "向量内积",
              "向量长度"
            ],
            "definition": "非零向量x、y的夹角为arccos([x,y]/(||x||||y||))。",
            "example": "(1,0)与(0,1)夹角为π/2",
            "section": "第一节 向量的内积、长度及正交性"
          },
          {
            "name": "正交向量",
            "difficulty": 1,
            "description": "内积为零的两个向量。",
            "aliases": [
              "正交"
            ],
            "prerequisites": [
              "向量内积"
            ],
            "definition": "当[x,y]=0时，称x与y正交。",
            "example": "(1,0)与(0,1)正交"
          },
          {
            "name": "正交向量组",
            "difficulty": 2,
            "description": "由两两正交非零向量组成的向量组。",
            "aliases": [],
            "prerequisites": [
              "正交向量"
            ],
            "definition": "一组两两正交的非零向量称为正交向量组。",
            "example": "标准坐标向量组是正交向量组",
            "section": "第一节 向量的内积、长度及正交性"
          },
          {
            "name": "规范正交基",
            "difficulty": 2,
            "description": "两两正交且均为单位向量的基。",
            "aliases": [
              "标准正交基",
              "正交规范基"
            ],
            "prerequisites": [
              "正交向量组",
              "单位向量"
            ],
            "definition": "由两两正交单位向量组成的向量空间基称为规范正交基。",
            "example": "e₁,e₂,e₃是R³的规范正交基"
          },
          {
            "name": "施密特正交化",
            "difficulty": 3,
            "description": "将向量空间基化为规范正交基的方法。",
            "aliases": [
              "施密特过程",
              "规范正交化"
            ],
            "prerequisites": [
              "向量内积",
              "向量长度",
              "规范正交基"
            ],
            "definition": "从一组基出发构造等价规范正交基的过程。",
            "example": "对(1,1),(1,0)施密特正交化"
          },
          {
            "name": "正交矩阵",
            "difficulty": 2,
            "description": "转置等于逆矩阵的实方阵。",
            "aliases": [],
            "prerequisites": [
              "规范正交基"
            ],
            "definition": "满足QᵀQ=E的实方阵称为正交矩阵。",
            "example": "二维旋转矩阵是正交矩阵"
          },
          {
            "name": "特征值",
            "difficulty": 2,
            "description": "使矩阵存在非零特征向量的标量。",
            "aliases": [],
            "prerequisites": [],
            "definition": "若存在非零向量x使Ax=λx，则λ称为A的特征值。",
            "example": "矩阵diag(2,3)的特征值为2、3"
          },
          {
            "name": "特征向量",
            "difficulty": 2,
            "description": "被矩阵作用后仅改变倍数的非零向量。",
            "aliases": [],
            "prerequisites": [
              "特征值"
            ],
            "definition": "满足Ax=λx的非零向量x称为对应于λ的特征向量。",
            "example": "diag(2,3)中e₁是特征向量"
          },
          {
            "name": "特征多项式",
            "difficulty": 2,
            "description": "矩阵A的行列式|A−λE|对应的多项式。",
            "aliases": [],
            "prerequisites": [
              "特征值"
            ],
            "definition": "f(λ)=|A−λE|称为矩阵A的特征多项式。",
            "example": "diag(2,3)的特征多项式为(2−λ)(3−λ)"
          },
          {
            "name": "相似矩阵",
            "difficulty": 2,
            "description": "可由可逆相似变换相互得到的矩阵。",
            "aliases": [
              "矩阵相似"
            ],
            "prerequisites": [],
            "definition": "若存在可逆P使P⁻¹AP=B，则A与B相似。",
            "example": "B=P⁻¹AP时，A与B相似"
          },
          {
            "name": "相似变换",
            "difficulty": 2,
            "description": "用P⁻¹AP变换方阵的运算。",
            "aliases": [
              "相似变换矩阵"
            ],
            "prerequisites": [
              "相似矩阵"
            ],
            "definition": "对矩阵A作P⁻¹AP的运算称为相似变换。",
            "example": "P⁻¹AP=Λ将A变为对角阵",
            "section": "第三节 相似矩阵"
          },
          {
            "name": "相似对角化",
            "difficulty": 3,
            "description": "通过相似变换将矩阵化为对角阵。",
            "aliases": [
              "可对角化"
            ],
            "prerequisites": [
              "相似矩阵",
              "特征向量"
            ],
            "definition": "存在可逆P使P⁻¹AP为对角阵称为相似对角化。",
            "example": "有三个线性无关特征向量的三阶矩阵可对角化"
          },
          {
            "name": "对角化条件",
            "difficulty": 3,
            "description": "矩阵可相似对角化的充要条件。",
            "aliases": [],
            "prerequisites": [
              "相似对角化",
              "特征向量"
            ],
            "definition": "n阶矩阵可对角化当且仅当有n个线性无关特征向量。",
            "example": "特征值互异的矩阵可对角化"
          },
          {
            "name": "实对称矩阵",
            "difficulty": 1,
            "description": "元素为实数且满足Aᵀ=A的矩阵。",
            "aliases": [],
            "prerequisites": [],
            "definition": "满足Aᵀ=A的实方阵称为实对称矩阵。",
            "example": "[[1,2],[2,3]]是实对称矩阵"
          },
          {
            "name": "实对称矩阵对角化",
            "difficulty": 3,
            "description": "实对称矩阵可用正交矩阵化为对角阵。",
            "aliases": [
              "正交对角化"
            ],
            "prerequisites": [
              "实对称矩阵",
              "正交矩阵"
            ],
            "definition": "实对称矩阵存在正交矩阵P使PᵀAP为对角阵。",
            "example": "对称矩阵可正交相似对角化"
          },
          {
            "name": "二次型",
            "difficulty": 2,
            "description": "变量平方项与两两乘积项组成的齐次二次式。",
            "aliases": [],
            "prerequisites": [],
            "definition": "含变量二次项和交叉乘积项的齐次二次多项式称为二次型。",
            "example": "x₁²+2x₁x₂+3x₂²"
          },
          {
            "name": "二次型矩阵",
            "difficulty": 2,
            "description": "表示二次型的对称矩阵A。",
            "aliases": [
              "矩阵表示"
            ],
            "prerequisites": [
              "二次型"
            ],
            "definition": "满足f(x)=xᵀAx的矩阵A称为二次型的矩阵。",
            "example": "x₁²+2x₁x₂+x₂²对应[[1,1],[1,1]]",
            "section": "第六节 正定二次型与正定矩阵"
          },
          {
            "name": "二次型的秩",
            "difficulty": 3,
            "description": "二次型矩阵的秩。",
            "aliases": [
              "秩"
            ],
            "prerequisites": [
              "二次型矩阵"
            ],
            "definition": "二次型的秩定义为其矩阵表示A的秩R(A)。",
            "example": "diag(1,2,0)表示的二次型秩为2"
          },
          {
            "name": "二次型标准形",
            "difficulty": 3,
            "description": "经正交变换化得的平方项对角形式。",
            "aliases": [
              "标准形"
            ],
            "prerequisites": [
              "二次型矩阵",
              "正交矩阵"
            ],
            "definition": "二次型经正交变换后仅含平方项的形式称为标准形。",
            "example": "−y₁²+2y₂²"
          },
          {
            "name": "二次型规范形",
            "difficulty": 3,
            "description": "经配方法化得系数为0、±1的形式。",
            "aliases": [
              "规范形"
            ],
            "prerequisites": [
              "二次型"
            ],
            "definition": "二次型经配方法化成系数为0、±1的平方和形式。",
            "example": "x₁²−x₂²"
          },
          {
            "name": "合同变换",
            "difficulty": 3,
            "description": "将对称矩阵变为PᵀAP的矩阵变换。",
            "aliases": [
