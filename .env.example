# Edu_Agent configuration.
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored (see .gitignore) — never commit real keys.
#
# The backend reads these via python-dotenv. Every API endpoint below must be
# an OpenAI-compatible **Chat Completions** API (the client uses the OpenAI
# Python SDK). Both templates below work — pick whichever matches your provider.
# Network calls are direct: the backend ignores HTTP_PROXY/HTTPS_PROXY/ALL_PROXY.

# ##################################################################
# TEMPLATE A — DeepSeek Official API
# ##################################################################
# Uses DeepSeek's official endpoint. Get your key at platform.deepseek.com.
# Uncomment the three lines and fill in your key.

# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key-here
# LLM_MODEL=deepseek-v4-flash

# ##################################################################
# TEMPLATE B — Generic Custom (any OpenAI-compatible Chat Completions)
# ##################################################################
# Works with any provider that exposes a Chat Completions endpoint.
# Examples:
#   OpenAI:        https://api.openai.com/v1            model: gpt-4o / gpt-5.6
#   Zhipu (GLM):   https://open.bigmodel.cn/api/paas/v4 model: glm-4.5
#   InfiniAI:      https://cloud.infini-ai.com/maas/v1  model: deepseek-v4-flash
#   Local (vLLM):  http://localhost:8000/v1             model: your-local-model
# Uncomment the three lines and fill in your details.

# LLM_BASE_URL=https://your-provider.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=your-model-name

# ##################################################################
# LLM tuning (applies to whichever template you chose above)
# ##################################################################
LLM_MAX_TOKENS=4000
# 64K 平衡档：主流模型（DeepSeek/GLM/Qwen 128K+）下既满足长周期辅导与多资料
# RAG 的上下文深度，又不让单轮输入 token 失控。模型窗口更小时请调低。
LLM_CONTEXT_WINDOW=65536
LLM_MAX_OUTPUT_TOKENS=8000
LLM_CONTEXT_SAFETY_MARGIN=2500
CONTEXT_SOFT_TRIGGER_RATIO=0.72
CONTEXT_HARD_TRIGGER_RATIO=0.88
CONTEXT_HISTORY_MAX_TOKENS=24000
CONTEXT_RECENT_FULL_TURNS=4
LLM_PROVIDER=openai_compatible
LLM_RUNTIME_MODE=adapter
LLM_SUPPORTS_REASONING=1
LLM_SUPPORTS_DISABLE_THINKING=1
LLM_SUPPORTS_REASONING_EFFORT=0
LLM_SUPPORTS_REASONING_BUDGET=0
LLM_REPORTS_REASONING_TOKENS=0
LLM_SUPPORTS_NATIVE_TOOL_MESSAGES=1
# real_summary = 模板过程摘要 + 对真实模型推理的二次提炼（每轮多一次小调用）；
# adaptive/standard/detailed/compact = 仅模板过程摘要。
REASONING_SUMMARY_LEVEL=adaptive
TOOL_CONTEXT_PROJECTION_MODE=on
TOOL_MESSAGE_MODE=native
# P9 反碎片化：证据整包注入预算。旧值 2000 让 6 条证据只装下 3-4 条且溢出
# 静默丢弃；6000 配合课文级合并与溢出指针行（可用 knowledge_read 取原文）。
TOOL_CONTEXT_CURRENT_MAX_CHARS=6000
TOOL_CONTEXT_OLD_PREVIEW_CHARS=400
# 出题后校验：critic = 结构校验 + LLM 独立重解审题（推荐）；
# basic = 仅确定性结构校验；off = 不校验（旧行为）。
QUIZ_VERIFY_MODE=critic
# 工具步保留模型思考（预算充足时）：1 = LOW 思考（real_summary 有真实材料，
# starving 由预算守卫与续写兜底）；0 = 旧行为（工具步一律关闭思考）。
EXECUTOR_TOOL_THINKING=1
# 工具步输出信封上限（max_tokens 是上限不是消费）。思考型模型的隐藏推理
# 与答案共用一个信封：顶太紧会被思考吃光、触发续写重试（更费 token）。
EXECUTOR_TOOL_MAX_OUTPUT_TOKENS=6000
# 真实推理的实时预览上限（字符）：流式期间把模型 reasoning 实时展示在
# 「深度思考」区。预览只是显示流，不进入 LLM 上下文窗口，故默认 0=不限长；
# 正数 N=只预览前 N 字；负数=关闭实时预览。
REASONING_LIVE_MAX_CHARS=-1
LLM_TEMPERATURE=0.3

# ##################################################################
# VISION / IMAGE MODEL (optional, Chat Completions format)
# ##################################################################
# When a student uploads a problem photo, this model reads the image and
# extracts the problem text (physics diagrams, formulas, etc).
#
# Same Chat Completions format as the main LLM above. Pick any vision-capable
# model your provider offers.
#
# - If you fill in all three lines -> image recognition uses this channel.
# - If you leave them empty      -> falls back to local tesseract OCR
#   (chi_sim+eng, requires tesseract installed; works offline, zero API cost).
#
# The vision model is used ONLY for image recognition. All quiz / explanation /
# answering still goes through the main LLM configured above.

# Example (GLM-4.6V on Zhipu):
# MULTIMODAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MULTIMODAL_API_KEY=sk-your-zhipu-key-here
# MULTIMODAL_MODEL=glm-4.6v

# Example (GPT-4o on OpenAI):
# MULTIMODAL_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_API_KEY=sk-your-openai-key-here
# MULTIMODAL_MODEL=gpt-4o

# Generic custom vision model (uncomment & fill in):
# MULTIMODAL_BASE_URL=https://your-provider.com/v1
# MULTIMODAL_API_KEY=sk-your-vision-key-here
# MULTIMODAL_MODEL=your-vision-model-name

# OCR 转录是提取任务：默认向视觉模型下发「关闭思考 + 最低思考强度」
# （thinking disabled + reasoning_effort low，网关 400 拒绝时自动去参重试）。
# 设为 0 恢复旧行为（不携带推理控制字段）。
MULTIMODAL_DISABLE_THINKING=1
# 单页 vision 调用最大尝试次数（API 异常与空 content 都按指数退避重试，
# 耗尽才回退本地 tesseract）。
MULTIMODAL_OCR_RETRIES=3

# ##################################################################
# SEMANTIC RAG EMBEDDING (optional)
# ##################################################################
# Provider is explicit and defaults to off, so old deployments remain pure
# BM25 until opted in. Vector failures always degrade to BM25.
#
# Local CPU MiniLM (recommended for Edu_Agent v1): model files must already
# exist in EMBEDDING_MODEL_PATH or EMBEDDING_CACHE_DIR. Runtime downloads are
# disabled. Paper_Agent and Edu_Agent may share this cache read-only, but never
# share Python environments, databases, or services.
# EMBEDDING_PROVIDER=local          # off | local | openai
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL_PATH=/opt/models/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE_DIR=/opt/model-cache/huggingface
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32           # 16 / 32 / 64
# EMBEDDING_MAX_THREADS=2           # OMP/MKL/torch threads; ML job concurrency stays 1
#
# OpenAI-compatible alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-openai-key-here
# EMBEDDING_MODEL=text-embedding-3-small
#
# Public textbook vectors are built/imported with backend/scripts; never copy
# or commit knowledge/vector_db (it can contain private runtime vectors).
# CHROMA_DIR=knowledge/vector_db
# RAG_HYBRID=1
# Structured RAG V2 rollout（教材刷新可复用既有 .txt，无需重做 OCR）：
RAG_CHUNKER_MODE=v2             # legacy | v2
RAG_EVIDENCE_GATE=on            # off | shadow | on
RAG_CONTEXT_COMPRESS=1          # 按完整 evidence excerpt 分配上下文预算，不截断标签
RAG_EVIDENCE_EXCERPT_CHARS=900  # 单条证据摘录上限（公式感知切句+定义句居中）

# ##################################################################
# TUTOR DEFAULTS
# ##################################################################
# 学段由用户画像/自动识别提供（DEFAULT_GRADE 已移除，配置项无消费方）。
# Hard cap on agent reasoning steps (prevents infinite tool loops).
AGENT_MAX_STEPS=6
# P2 教材库：上传教材 PDF 后自动解析+检索索引+构建专属知识图谱。
#   TEXTBOOK_GRAPH_ENABLED=0 时上传只解析+索引，跳过图谱构建（教材仍可检索）。
TEXTBOOK_GRAPH_ENABLED=1
# 教材图谱章节/概念容量默认不限制；在上传页或教材详情中按教材组/单本设置。
# 扫描版/图片型 PDF OCR 回退（逐页渲染→OCR→拼回文本，复用 RAG/图谱管线）。
#   PDF_OCR_MODE: auto=仅扫描PDF触发 / on=所有PDF都OCR(调试) / off=禁用(扫描PDF被拒)
# 视觉模型走 MULTIMODAL_*；未配则用本地 tesseract（WSL2: sudo apt install
# tesseract-ocr tesseract-ocr-chi-sim）。对话/工作区/普通资料库保持短重试后 tesseract 回退。
PDF_OCR_MODE=auto
PDF_OCR_MAX_PAGES=1024       # 教材库后台 OCR 页数上限（默认覆盖整本教材）
PDF_OCR_SYNC_MAX_PAGES=20    # 对话/资料库同步 OCR 页数上限（保响应性）
PDF_OCR_DPI=200
PDF_OCR_CONCURRENCY=20       # 全系统教材后台 OCR 页面并发 bootstrap；管理员可在 1-64 间动态调整
# 教材 OCR 的失败策略/最大尝试/重试间隔/单次超时由管理员页面热更新并
# 持久化到 chat_history/settings/ocr_policy.json；默认 persistent_api：
# 失败页约每 60 秒重试多模态 API，直至成功，不自动降级。这里不保存密钥。
# M10 Skill Runtime mode (start.sh/.env.example use the complete gated path):
#   shadow = record contract-aware decisions without changing execution;
#   gated  = enforce preconditions, minimal clarification, and stepwise tools;
#   off    = disable Skill decision/card diagnostics.
SKILL_RUNTIME_MODE=gated

# ##################################################################
# TRACES & SERVER
# ##################################################################
TRACE_DIR=./traces
API_HOST=127.0.0.1
API_PORT=8000

# FRONTEND_MODE (start.sh only): prod = build once + `next start` (minified,
# prefetching, fast page loads — default); dev = hot-reload dev server for
# active frontend development. REBUILD=1 ./start.sh forces a prod rebuild.
FRONTEND_MODE=prod

# ##################################################################
# M0 IDENTITY & ACCOUNT SYSTEM (用户身份层)
# ##################################################################
# AUTH_MODE: 0 = anonymous/guest (single shared student, no login needed),
#            1 = login required (each user gets isolated student data).
# Default is 0 so the system runs out-of-the-box. Set to 1 to enable
# multi-user registration/login with JWT-based data isolation.
AUTH_MODE=0
# ADMIN BOOTSTRAP（可选）：启动时确保该账号存在且 role=admin——管理员可上传/
# 管理公用教材库（所有账号可选用）、查看/注销账号。不配则不创建管理员。
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-in-production

# CROSS_SESSION_MEMORY（详细 transcript 跨会话召回范围，P6-D；精简 prompt memory 另按用户窗口管理）：
#   workspace（默认）= 仅工作区内跨对话（公共记忆 + 同工作区会话召回）；
#   all = 该生全部会话（旧行为）；off = 完全关闭跨会话召回与记忆注入。
# 独立对话不跨对话调用聊天详细记录；长期记忆只保留学生水平（M2）与
# 语言/表达风格（M8）。
CROSS_SESSION_MEMORY=workspace

# JWT secret for signing auth tokens. MUST be changed in production (any
# random string >= 32 chars). If left as the default, a dev-only secret is
# used and the frontend shows a warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_JWT_SECRET=your-strong-random-secret-here

# Auth token expiry (days) and bcrypt hashing rounds.
AUTH_TOKEN_EXPIRE_DAYS=30
AUTH_BCRYPT_ROUNDS=12

# ##################################################################
# CONTEXT ENGINEERING (optional tuning)
# ##################################################################
# Soft token budget before LLM compaction triggers (estimate_tokens heuristic).
# EDU_SOFT_BUDGET_TOKENS=6000
# (legacy: EDU_SOFT_BUDGET_CHARS still honored, converted ~4 chars/token)

# ##################################################################
# PRODUCTION DEPLOYMENT CHECKLIST (生产部署清单)
# ##################################################################
# Deploying behind nginx (same-origin reverse proxy, see docs/The_Website_deployment_plan.md)?
# Review these before going live:
#
# 1) AUTH_MODE=1  — enable multi-user login + per-user data isolation.
#    The default 0 (anonymous, single shared student) is for local dev only.
# AUTH_MODE=1
#
# 2) AUTH_JWT_SECRET  — MUST be replaced with a strong random string
#    (see the M0 section above for the generator command). The dev default
#    lets anyone forge login tokens.
# AUTH_JWT_SECRET=paste-generated-secret-here
#
# 3) CORS_ORIGINS  — comma-separated allowlist of frontend origins, e.g.
#    CORS_ORIGINS=https://edu-agent.invincible-summer.xyz
#    In the same-origin nginx form the browser never sends cross-origin
#    requests; this is the allowlist for the cross-origin form / a safety
#    net. Do NOT leave it as * in production.
# CORS_ORIGINS=https://edu-agent.invincible-summer.xyz
#
# 4) TRACE_DIR  — optional. The default now resolves to an absolute path
#    anchored at <project root>/backend/traces (cwd-independent, so systemd
#    units can't scatter data). Relative values resolve against backend/;
#    set an absolute path only if you want traces elsewhere.
# TRACE_DIR=/opt/edu-agent/backend/traces
#
# 5) COMPAT_API_KEY  — OpenAI 兼容门面（/api/v1/models + /chat/completions）
#    的接入凭证，供学校平台/第三方系统按 OpenAI 兼容协议接入本 Agent。
#    不设置 = 门面关闭（端点返回 503）。设置即一个强随机串：
#    python -c "import secrets; print('COMPAT_API_KEY=' + secrets.token_urlsafe(32))"
# COMPAT_API_KEY=
# 门面会话的默认学段（接入侧无学段概念，按部署面向的学生群体设定）：
# COMPAT_GRADE=高中
#
# 6) PDF_OCR_CONCURRENCY=2 — 与 Paper Agent/myBlog 同机时使用保守并发，
#    避免大教材 OCR 抢占共享 CPU/内存；独占高配机器再按实测调整。
# PDF_OCR_CONCURRENCY=2
#
# And: chmod 600 .env — this file contains API keys and the JWT secret.
